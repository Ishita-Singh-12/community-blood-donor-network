# Optional: persistent MongoDB instead of the temporary demo database.
# MONGODB_URI=mongodb://127.0.0.1:27017/blood_donor_network
PORT=4173
# Default bind is loopback. This is a demo, not a public production service.
HOST=127.0.0.1

# Split frontend/backend hosting (never place MongoDB credentials in VITE_* vars).
# VITE_API_URL=https://your-backend-host
# CLIENT_ORIGIN=https://Ishita-Singh-12.github.io
# For a hosted backend only:
# NODE_ENV=production
# HOST=0.0.0.0
# TRUST_PROXY=1

# VITE_BASE_PATH=/community-blood-donor-network/

# v2 account/assistant/push configuration. Persistent Mongo must support transactions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Only for explicit bootstrap-admin command; not seeded in persistent mode.
ADMIN_EMAIL=
ADMIN_PASSWORD=
